.tahoe-root {
    --tahoe-bg-app: #0b0e17;
    --tahoe-bg-shell: rgba(22, 26, 38, 0.94);
    --tahoe-bg-window: rgba(28, 33, 48, 0.97);
    --tahoe-bg-window-focused: rgba(34, 40, 58, 0.99);
    --tahoe-bg-surface: rgba(255, 255, 255, 0.06);
    --tahoe-bg-surface-hover: rgba(255, 255, 255, 0.12);
    --tahoe-border-specular: rgba(255, 255, 255, 0.30);
    --tahoe-border-glass: rgba(255, 255, 255, 0.14);
    --tahoe-border-focused: rgba(10, 132, 255, 0.80);
    --tahoe-text-primary: #f5f7fa;
    --tahoe-text-secondary: rgba(235, 235, 245, 0.66);
    --tahoe-text-muted: rgba(235, 235, 245, 0.44);
    --tahoe-accent: #0a84ff;
    --tahoe-bench: #5e5ce6;
    --tahoe-danger: #ff453a;
    --tahoe-success: #30d158;
    --tahoe-stage-bg: rgba(0, 0, 0, 0.28);

    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 16px;
    background-color: #04060c;
}

.tahoe-root .unity-text-element {
    -unity-font: none;
    -unity-font-definition: url("project://database/Assets/Showcase/Fonts/Inter-Regular%20SDF.asset?fileID=11400000&guid=cc59427566c6b164f949dc6c3ff3cef9&type=2#Inter-Regular SDF");
    color: var(--tahoe-text-primary);
}

.tahoe-root .font-mono-fui {
    -unity-font: none;
    -unity-font-definition: url("project://database/Assets/Showcase/Fonts/JetBrainsMono-Regular%20SDF.asset?fileID=11400000&guid=0ba43c5dbe5cc4f4f85382979ce1230e&type=2#JetBrainsMono-Regular SDF");
}

.theme-tahoe-white {
    --tahoe-bg-app: #e6ebf4;
    --tahoe-bg-shell: rgba(242, 246, 252, 0.96);
    --tahoe-bg-window: rgba(255, 255, 255, 0.97);
    --tahoe-bg-window-focused: rgba(255, 255, 255, 0.99);
    --tahoe-bg-surface: rgba(15, 23, 42, 0.06);
    --tahoe-bg-surface-hover: rgba(15, 23, 42, 0.11);
    --tahoe-border-specular: rgba(255, 255, 255, 0.96);
    --tahoe-border-glass: rgba(15, 23, 42, 0.14);
    --tahoe-border-focused: rgba(0, 122, 255, 0.68);
    --tahoe-text-primary: #141824;
    --tahoe-text-secondary: rgba(20, 24, 36, 0.68);
    --tahoe-text-muted: rgba(20, 24, 36, 0.46);
    --tahoe-accent: #007aff;
    --tahoe-bench: #5856d6;
    --tahoe-danger: #ff3b30;
    --tahoe-success: #28cd41;
    --tahoe-stage-bg: rgba(15, 23, 42, 0.08);
}

.theme-tahoe-indigo {
    --tahoe-bg-app: #0d0b1c;
    --tahoe-bg-shell: rgba(26, 22, 52, 0.95);
    --tahoe-bg-window: rgba(34, 29, 68, 0.97);
    --tahoe-bg-window-focused: rgba(42, 36, 82, 0.99);
    --tahoe-bg-surface: rgba(191, 90, 242, 0.12);
    --tahoe-bg-surface-hover: rgba(191, 90, 242, 0.22);
    --tahoe-border-specular: rgba(230, 210, 255, 0.34);
    --tahoe-border-glass: rgba(191, 90, 242, 0.22);
    --tahoe-border-focused: rgba(191, 90, 242, 0.80);
    --tahoe-text-primary: #f8f5ff;
    --tahoe-text-secondary: rgba(235, 225, 255, 0.68);
    --tahoe-text-muted: rgba(235, 225, 255, 0.45);
    --tahoe-accent: #bf5af2;
    --tahoe-bench: #5e5ce6;
    --tahoe-danger: #ff375f;
    --tahoe-success: #30d158;
    --tahoe-stage-bg: rgba(8, 4, 24, 0.34);
}

.theme-tahoe-crimson {
    --tahoe-bg-app: #160a0e;
    --tahoe-bg-shell: rgba(40, 18, 24, 0.95);
    --tahoe-bg-window: rgba(52, 22, 31, 0.97);
    --tahoe-bg-window-focused: rgba(64, 27, 38, 0.99);
    --tahoe-bg-surface: rgba(255, 55, 95, 0.11);
    --tahoe-bg-surface-hover: rgba(255, 55, 95, 0.20);
    --tahoe-border-specular: rgba(255, 215, 225, 0.32);
    --tahoe-border-glass: rgba(255, 55, 95, 0.20);
    --tahoe-border-focused: rgba(255, 55, 95, 0.75);
    --tahoe-text-primary: #fff5f7;
    --tahoe-text-secondary: rgba(255, 225, 232, 0.68);
    --tahoe-text-muted: rgba(255, 225, 232, 0.45);
    --tahoe-accent: #ff375f;
    --tahoe-bench: #ff9f0a;
    --tahoe-danger: #ff453a;
    --tahoe-success: #30d158;
    --tahoe-stage-bg: rgba(18, 4, 8, 0.34);
}

.tahoe-shell {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    border-radius: 30px;
    background-color: var(--tahoe-bg-shell);
    border-width: 1px;
    border-top-color: var(--tahoe-border-specular);
    border-left-color: var(--tahoe-border-glass);
    border-right-color: var(--tahoe-border-glass);
    border-bottom-color: var(--tahoe-border-glass);
    padding: 20px 24px;
    flex-direction: column;
    overflow: hidden;
    transition-property: background-color, border-color;
    transition-duration: 0.25s;
}

.tahoe-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--tahoe-border-glass);
    flex-shrink: 0;
}

.tahoe-header-left {
    flex-direction: row;
    align-items: center;
}

.tahoe-traffic-dots {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.tahoe-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 6px;
}

.tahoe-dot-sm {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
}

.tahoe-dot-red { background-color: #ff5f56; }
.tahoe-dot-amber { background-color: #ffbd2e; }
.tahoe-dot-green { background-color: #27c93f; }

.tahoe-back-pill {
    flex-direction: row;
    align-items: center;
    padding: 6px 14px;
    border-radius: 12px;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    margin-right: 14px;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.tahoe-back-pill:hover {
    background-color: var(--tahoe-accent);
    border-color: var(--tahoe-accent);
}

.tahoe-back-pill-arrow {
    font-size: 12px;
    color: var(--tahoe-text-primary);
    margin-right: 6px;
}

.tahoe-back-pill-text {
    font-size: 12px;
    color: var(--tahoe-text-primary);
}

.tahoe-back-pill:hover .tahoe-back-pill-arrow,
.tahoe-back-pill:hover .tahoe-back-pill-text {
    color: #ffffff;
}

.tahoe-brand-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--tahoe-text-primary);
}

.tahoe-telemetry-pill {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    border-radius: 11px;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
}

.tahoe-telemetry-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--tahoe-success);
    margin-right: 8px;
}

.tahoe-telemetry-text {
    font-size: 11px;
    color: var(--tahoe-text-primary);
}

.tahoe-telemetry-sep {
    font-size: 11px;
    color: var(--tahoe-text-muted);
    margin: 0 8px;
}

.tahoe-header-actions {
    flex-direction: row;
    align-items: center;
}

.tahoe-action-btn {
    padding: 6px 12px;
    margin-left: 8px;
    border-radius: 10px;
    font-size: 12px;
    -unity-font-style: bold;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    color: var(--tahoe-text-primary);
    transition-property: background-color;
    transition-duration: 0.16s;
}

.tahoe-action-btn:hover {
    background-color: var(--tahoe-bg-surface-hover);
}

.tahoe-bench-btn {
    background-color: var(--tahoe-bench);
    border-color: var(--tahoe-bench);
    color: #ffffff;
}

.tahoe-bench-btn:hover {
    background-color: var(--tahoe-accent);
    border-color: var(--tahoe-accent);
}

.tahoe-close-all-btn {
    background-color: rgba(255, 69, 58, 0.16);
    border-color: rgba(255, 69, 58, 0.35);
    color: var(--tahoe-danger);
}

.tahoe-close-all-btn:hover {
    background-color: var(--tahoe-danger);
    border-color: var(--tahoe-danger);
    color: #ffffff;
}

.tahoe-workspace {
    flex-grow: 1;
    flex-direction: row;
    padding-top: 14px;
    min-height: 0;
}

.tahoe-sidebar {
    width: 282px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: var(--tahoe-border-glass);
    padding-right: 16px;
    flex-direction: column;
    justify-content: space-between;
}

.tahoe-section-title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--tahoe-text-secondary);
    margin-bottom: 10px;
}

.tahoe-nav-stack {
    flex-grow: 1;
    flex-direction: column;
}

.tahoe-nav-btn {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 8px;
    border-radius: 13px;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-top-color: var(--tahoe-border-specular);
    border-left-color: var(--tahoe-border-glass);
    border-right-color: var(--tahoe-border-glass);
    border-bottom-color: var(--tahoe-border-glass);
    transition-property: background-color, border-color;
    transition-duration: 0.16s;
}

.tahoe-nav-btn:hover {
    background-color: var(--tahoe-bg-surface-hover);
}

.tahoe-nav-btn.is-open {
    border-color: var(--tahoe-border-focused);
    background-color: var(--tahoe-bg-surface-hover);
}

.tahoe-nav-icon-box {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tahoe-icon-sky { background-color: rgba(14, 165, 233, 0.22); }
.tahoe-icon-indigo { background-color: rgba(99, 102, 241, 0.22); }
.tahoe-icon-teal { background-color: rgba(20, 184, 166, 0.22); }
.tahoe-icon-rose { background-color: rgba(244, 63, 94, 0.22); }
.tahoe-icon-amber { background-color: rgba(245, 158, 11, 0.22); }
.tahoe-icon-orange { background-color: rgba(249, 115, 22, 0.22); }
.tahoe-icon-purple { background-color: rgba(168, 85, 247, 0.22); }

.tahoe-nav-icon {
    width: 16px;
    height: 16px;
}

.tahoe-nav-label {
    font-size: 12px;
    color: var(--tahoe-text-primary);
    -unity-font-style: bold;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.tahoe-info-card {
    padding: 12px 14px;
    border-radius: 16px;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    margin-top: 8px;
}

.tahoe-info-title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    color: var(--tahoe-text-primary);
    margin-bottom: 4px;
}

.tahoe-info-desc {
    font-size: 11px;
    color: var(--tahoe-text-secondary);
    white-space: normal;
}

.tahoe-stage-column {
    flex-grow: 1;
    flex-direction: column;
    padding-left: 16px;
    min-width: 0;
    min-height: 0;
}

.tahoe-stage-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.tahoe-stage-header {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--tahoe-text-secondary);
}

.tahoe-bench-badge {
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    background-color: rgba(48, 209, 88, 0.18);
    border-width: 1px;
    border-color: rgba(48, 209, 88, 0.40);
    color: var(--tahoe-success);
}

.tahoe-window-stage {
    position: relative;
    flex-grow: 1;
    border-radius: 20px;
    background-color: var(--tahoe-stage-bg);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    overflow: hidden;
}

.tahoe-empty-state {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.tahoe-empty-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

.tahoe-empty-icon {
    width: 22px;
    height: 22px;
}

.tahoe-empty-label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    color: var(--tahoe-text-muted);
}

.tahoe-floating-window {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 18px;
    background-color: var(--tahoe-bg-window);
    border-width: 1px;
    border-top-color: var(--tahoe-border-specular);
    border-left-color: var(--tahoe-border-glass);
    border-right-color: var(--tahoe-border-glass);
    border-bottom-color: var(--tahoe-border-glass);
    overflow: hidden;
}

.tahoe-floating-window.is-focused {
    background-color: var(--tahoe-bg-window-focused);
    border-color: var(--tahoe-border-focused);
}

.tahoe-win-w-360 { width: 380px; }
.tahoe-win-w-400 { width: 410px; }
.tahoe-win-w-420 { width: 440px; }

.tahoe-win-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--tahoe-border-glass);
}

.tahoe-win-title-row {
    flex-direction: row;
    align-items: center;
}

.tahoe-win-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--tahoe-text-primary);
    margin-left: 4px;
}

.tahoe-win-close {
    width: 24px;
    height: 24px;
    border-radius: 8px;
    background-color: var(--tahoe-bg-surface);
    border-width: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--tahoe-text-primary);
    padding: 0;
}

.tahoe-win-close:hover {
    background-color: var(--tahoe-danger);
    color: #ffffff;
}

.tahoe-win-body {
    padding: 14px;
    flex-direction: column;
}

.tahoe-chip-wrap {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.tahoe-hook-btn {
    padding: 5px 10px;
    margin: 0 6px 6px 0;
    border-radius: 8px;
    font-size: 11px;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    color: var(--tahoe-text-primary);
}

.tahoe-hook-btn.is-active {
    background-color: var(--tahoe-accent);
    border-color: var(--tahoe-accent);
    color: #ffffff;
}

.tahoe-card-box {
    padding: 10px 12px;
    border-radius: 12px;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.tahoe-card-col {
    flex-direction: column;
    flex-shrink: 1;
    margin-right: 10px;
}

.tahoe-sub-label {
    font-size: 11.5px;
    color: var(--tahoe-text-secondary);
}

.tahoe-accent-value {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--tahoe-accent);
}

.tahoe-counter-big {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--tahoe-text-primary);
}

.tahoe-btn-row-3 {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
}

.tahoe-pill-action {
    flex-grow: 1;
    padding: 7px 10px;
    margin: 0 3px;
    border-radius: 10px;
    font-size: 12px;
    -unity-font-style: bold;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    color: var(--tahoe-text-primary);
}

.tahoe-pill-action:hover {
    background-color: var(--tahoe-bg-surface-hover);
}

.tahoe-pill-primary {
    background-color: var(--tahoe-accent);
    border-color: var(--tahoe-accent);
    color: #ffffff;
}

.tahoe-scroll-list {
    height: 220px;
}

.tahoe-list-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 5px 10px;
    margin-bottom: 5px;
    border-radius: 8px;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
}

.tahoe-list-row-left {
    flex-direction: row;
    align-items: center;
}

.tahoe-list-idx {
    font-size: 10.5px;
    color: var(--tahoe-text-muted);
    margin-right: 8px;
}

.tahoe-list-title {
    font-size: 11px;
    color: var(--tahoe-text-primary);
}

.tahoe-list-slot {
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 10px;
    background-color: rgba(20, 184, 166, 0.16);
    color: #2dd4bf;
}

.tahoe-modal-info {
    padding: 12px;
    border-radius: 12px;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    margin-bottom: 10px;
}

.tahoe-modal-info-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--tahoe-text-primary);
    margin-bottom: 4px;
}

.tahoe-modal-info-desc {
    font-size: 11px;
    color: var(--tahoe-text-secondary);
    white-space: normal;
}

.tahoe-modal-sheet {
    padding: 10px 12px;
    border-radius: 12px;
    background-color: rgba(10, 132, 255, 0.16);
    border-width: 1px;
    border-color: var(--tahoe-accent);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.tahoe-sheet-dismiss {
    padding: 4px 10px;
    border-radius: 8px;
    background-color: var(--tahoe-accent);
    border-width: 0;
    color: #ffffff;
    font-size: 11px;
    -unity-font-style: bold;
}

.tahoe-inv6-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 8px;
}

.tahoe-inv-slot {
    border-radius: 10px;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    align-items: center;
    justify-content: center;
    padding: 8px 6px;
}

.tahoe-inv-slot:hover {
    background-color: var(--tahoe-bg-surface-hover);
}

.tahoe-inv-slot.is-selected {
    border-color: var(--tahoe-accent);
    background-color: rgba(10, 132, 255, 0.18);
}

.tahoe-inv6-slot {
    width: 31.5%;
    margin: 0 0 6px 0;
    padding: 8px 4px;
}

.tahoe-inv6-name {
    font-size: 9px;
    color: var(--tahoe-text-primary);
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
}

.tahoe-inv6-cat {
    font-size: 9px;
    color: var(--tahoe-text-muted);
    margin-bottom: 2px;
}

.tahoe-inv100-scroll {
    height: 205px;
    margin-bottom: 10px;
}

.tahoe-inv100-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.tahoe-inv100-slot {
    width: 74px;
    height: 44px;
    margin: 2px;
    padding: 4px;
}

.tahoe-inv100-code {
    font-size: 9.5px;
    color: var(--tahoe-text-secondary);
}

.tahoe-rarity-pill {
    padding: 3px 8px;
    border-radius: 10px;
    font-size: 10px;
    -unity-font-style: bold;
    background-color: rgba(10, 132, 255, 0.20);
    color: var(--tahoe-accent);
    flex-shrink: 0;
}

.tahoe-theme-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.tahoe-theme-btn {
    width: 48%;
    padding: 10px 10px;
    margin: 0 0 8px 0;
    border-radius: 12px;
    background-color: var(--tahoe-bg-surface);
    border-width: 1px;
    border-color: var(--tahoe-border-glass);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.tahoe-theme-btn.is-active {
    border-color: var(--tahoe-accent);
    background-color: var(--tahoe-bg-surface-hover);
}

.tahoe-swatch {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
}

.tahoe-swatch-dark { background-color: #1e2332; }
.tahoe-swatch-white { background-color: #f8fafc; }
.tahoe-swatch-indigo { background-color: #2a2452; }
.tahoe-swatch-crimson { background-color: #401b26; }
