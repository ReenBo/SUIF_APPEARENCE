.hub-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 16px;
    background-color: #04060c;
    align-items: center;
    justify-content: center;
}

.hub-root .unity-text-element {
    -unity-font: none;
    -unity-font-definition: url("project://database/Assets/Showcase/Fonts/Inter-Regular%20SDF.asset?fileID=11400000&guid=cc59427566c6b164f949dc6c3ff3cef9&type=2#Inter-Regular SDF");
}

.hub-root .font-mono-fui {
    -unity-font: none;
    -unity-font-definition: url("project://database/Assets/Showcase/Fonts/JetBrainsMono-Regular%20SDF.asset?fileID=11400000&guid=0ba43c5dbe5cc4f4f85382979ce1230e&type=2#JetBrainsMono-Regular SDF");
}

.hub-stage {
    position: relative;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    border-radius: 30px;
    background-color: #080b14;
    border-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.22);
    border-left-color: rgba(255, 255, 255, 0.14);
    border-right-color: rgba(255, 255, 255, 0.14);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}

.hub-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hub-blur-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 14, 26, 0.36);
}

.hub-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 32px 24px 24px 24px;
}

.hub-header {
    width: 100%;
    max-width: 680px;
    flex-direction: column;
    align-items: center;
}

.hub-eyebrow {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    border-radius: 11px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    margin-bottom: 10px;
}

.hub-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #22d3ee;
    margin-right: 8px;
}

.hub-eyebrow-text {
    font-size: 11px;
    letter-spacing: 0.8px;
    color: rgba(103, 232, 249, 0.92);
}

.hub-title {
    font-size: 38px;
    color: #f8fafc;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.hub-lead {
    font-size: 16px;
    color: rgba(248, 250, 252, 0.94);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.hub-desc {
    font-size: 13px;
    color: rgba(203, 213, 225, 0.82);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 580px;
    margin-bottom: 12px;
}

.hub-pills-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.hub-pill-badge {
    padding: 4px 12px;
    margin: 3px 4px;
    border-radius: 9px;
    font-size: 11px;
    background-color: rgba(255, 255, 255, 0.055);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    color: rgba(248, 250, 252, 0.88);
}

.hub-pill-cyan {
    color: rgba(165, 243, 252, 0.94);
}

.hub-pill-sky {
    color: rgba(186, 230, 253, 0.94);
}

.hub-pill-violet {
    color: rgba(221, 214, 254, 0.94);
}

.hub-grid-wrap {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.hub-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    width: 420px;
}

.squircle-card {
    width: 180px;
    height: 180px;
    margin: 12px;
    padding: 16px;
    border-radius: 34px;
    background-color: rgba(255, 255, 255, 0.055);
    border-width: 1.5px;
    border-top-color: rgba(255, 255, 255, 0.42);
    border-left-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(15, 23, 42, 0.25);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.22s;
}

.squircle-card.is-hovered {
    background-color: rgba(255, 255, 255, 0.11);
}

.card-cyberpunk.is-hovered {
    border-color: rgba(0, 240, 255, 0.75);
}

.card-macos.is-hovered {
    border-color: rgba(96, 165, 250, 0.78);
}

.card-future.is-hovered {
    border-color: rgba(167, 139, 250, 0.55);
}

.card-emblem-box {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.card-emblem-icon {
    width: 28px;
    height: 28px;
}

.card-label {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.95);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.card-label-muted {
    color: rgba(255, 255, 255, 0.76);
}

.hub-footer {
    height: 36px;
    width: 100%;
    align-items: center;
    justify-content: center;
}

.hub-pill-toast {
    flex-direction: row;
    align-items: center;
    padding: 6px 16px;
    border-radius: 13px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    opacity: 0;
    translate: 0 10px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.hub-pill-toast.is-visible {
    opacity: 1;
    translate: 0 0;
}

.hub-toast-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #a78bfa;
    margin-right: 8px;
}

.hub-toast-text {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.92);
    -unity-font-style: bold;
}
