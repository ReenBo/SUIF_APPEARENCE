<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="../Styles/CyberpunkTheme.uss" />

    <ui:VisualElement name="ShowcaseFrameRoot" class="fui-root theme-mono" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="MainFrame" class="fui-frame">
            
            <ui:Label text="+ FRM_00" class="fui-hud-notch-tl" />
            <ui:Label text="ABER_MONO // UTF-8 ×" class="fui-hud-notch-tr" />
            <ui:Label text="[SYS_LOC: 0x00F49A]" class="fui-hud-notch-bl" />
            <ui:Label text="+ ////////////////////// +" class="fui-hud-notch-br" />

            <ui:VisualElement class="fui-header">
                <ui:VisualElement class="fui-header-top">
                    <ui:VisualElement class="fui-header-left">
                        <ui:VisualElement class="fui-hazard-box">
                            <ui:VisualElement class="fui-hazard-pattern" />
                        </ui:VisualElement>
                        <ui:VisualElement class="fui-header-titles">
                            <ui:VisualElement class="fui-sub-title-row">
                                <ui:VisualElement class="fui-sub-title-dot" />
                                <ui:Label text="CYBERPUNK_UISET // ARCHITECTURE_PROTOTYPE" class="fui-sub-title-text" />
                                <ui:Label text="[v0.9.4]" class="fui-sub-title-version" />
                            </ui:VisualElement>
                            <ui:VisualElement class="fui-main-title-row">
                                <ui:Label text="WELCOME TO SUIF" class="fui-main-title" />
                                <ui:Label text="KERNEL_READY" class="fui-kernel-badge" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="fui-header-right">
                        <ui:VisualElement class="fui-telemetry-row">
                            <ui:Label text="ACTIVE_BASE:" class="fui-telemetry-label" />
                            <ui:Label name="telemetry-base-readout" text="01_LIFECYCLE" class="fui-telemetry-value" />
                            <ui:Label text="■" class="fui-telemetry-pip" />
                        </ui:VisualElement>
                        <ui:VisualElement class="fui-telemetry-row">
                            <ui:Label text="OVERLAY_STACK:" class="fui-telemetry-label" />
                            <ui:Label name="telemetry-modal-readout" text="STANDBY [0]" class="fui-telemetry-badge" />
                        </ui:VisualElement>
                        <ui:VisualElement class="fui-segmented-bar">
                            <ui:VisualElement class="fui-segment-block" />
                            <ui:VisualElement class="fui-segment-block" />
                            <ui:VisualElement class="fui-segment-block" />
                            <ui:VisualElement class="fui-segment-block" />
                            <ui:VisualElement class="fui-segment-block-dim" />
                            <ui:VisualElement class="fui-segment-fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="fui-divider-row">
                    <ui:VisualElement class="fui-divider-line" />
                    <ui:VisualElement class="fui-divider-notch" />
                    <ui:Label text="┼ SECT_SPLIT ┼" class="fui-divider-tag" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="fui-workspace">
                
                <ui:VisualElement class="fui-sidebar">
                    <ui:VisualElement>
                        <ui:VisualElement class="fui-sidebar-section-header">
                            <ui:VisualElement class="fui-sidebar-section-top">
                                <ui:VisualElement class="fui-sidebar-title-row">
                                    <ui:Label text="»" class="fui-sidebar-chevron" />
                                    <ui:Label text="available views" class="fui-sidebar-title" />
                                </ui:VisualElement>
                                <ui:Label text="05 // NODES" class="fui-sidebar-count-badge" />
                            </ui:VisualElement>
                            <ui:VisualElement class="fui-sidebar-underline">
                                <ui:VisualElement class="fui-underline-white" />
                                <ui:VisualElement class="fui-underline-red" />
                                <ui:VisualElement class="fui-underline-fade" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="fui-nav-stack">
                            <ui:Button name="nav-btn-lifecycle" class="fui-nav-btn is-active">
                                <ui:VisualElement class="fui-nav-btn-left">
                                    <ui:Label text="01" class="fui-btn-tag" />
                                    <ui:Label text="Basic Window Lifecycle" class="fui-btn-label" />
                                </ui:VisualElement>
                                <ui:Label text="+" class="fui-btn-arrow" />
                            </ui:Button>

                            <ui:Button name="nav-btn-mvvm" class="fui-nav-btn">
                                <ui:VisualElement class="fui-nav-btn-left">
                                    <ui:Label text="02" class="fui-btn-tag" />
                                    <ui:Label text="MVVM &amp; R3 Reactive Counter" class="fui-btn-label" />
                                </ui:VisualElement>
                                <ui:Label text="›" class="fui-btn-arrow" />
                            </ui:Button>

                            <ui:Button name="nav-btn-list" class="fui-nav-btn">
                                <ui:VisualElement class="fui-nav-btn-left">
                                    <ui:Label text="03" class="fui-btn-tag" />
                                    <ui:Label text="Virtualized Recycled List" class="fui-btn-label" />
                                </ui:VisualElement>
                                <ui:Label text="|||" class="fui-btn-arrow" />
                            </ui:Button>

                            <ui:Button name="nav-btn-modals" class="fui-nav-btn">
                                <ui:VisualElement class="fui-nav-btn-left">
                                    <ui:Label text="04" class="fui-btn-tag" />
                                    <ui:Label text="Modals/Popups" class="fui-btn-label" />
                                </ui:VisualElement>
                                <ui:Label text="&gt;&gt;&gt;" class="fui-btn-arrow" />
                            </ui:Button>

                            <ui:Button name="nav-btn-inventory" class="fui-nav-btn">
                                <ui:VisualElement class="fui-nav-btn-left">
                                    <ui:Label text="05" class="fui-btn-tag" />
                                    <ui:Label text="INVENTORY" class="fui-btn-label" />
                                </ui:VisualElement>
                                <ui:Label text="×" class="fui-btn-arrow" />
                            </ui:Button>
                        </ui:VisualElement>

                        <ui:VisualElement class="fui-sidebar-note">
                            <ui:VisualElement>
                                <ui:Label text="MODAL_EXCEPTION_RULE" class="fui-note-title" />
                                <ui:Label text="[04] STACKS OVER ACTIVE VIEW" class="fui-note-sub" />
                            </ui:VisualElement>
                            <ui:Label text="[BUS]" class="fui-note-title" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="fui-sidebar-bottom">
                        <ui:Button name="nav-btn-theme" class="fui-nav-btn">
                            <ui:VisualElement class="fui-nav-btn-left">
                                <ui:Label text="06" class="fui-btn-tag" />
                                <ui:Label text="Dynamic Theme Switcher" class="fui-btn-label" />
                            </ui:VisualElement>
                            <ui:Label text="■" class="fui-btn-arrow" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="fui-v-divider">
                    <ui:Label text="▲" class="fui-v-arrow" />
                    <ui:VisualElement class="fui-v-line">
                        <ui:VisualElement class="fui-v-tick" />
                        <ui:VisualElement class="fui-v-center-box">
                            <ui:Label text="+" class="fui-v-center-text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="fui-v-tick" />
                    </ui:VisualElement>
                    <ui:Label text="▼" class="fui-v-arrow" />
                </ui:VisualElement>

                <ui:VisualElement class="fui-viewport-container">
                    
                    <ui:VisualElement class="fui-viewport-status-bar">
                        <ui:VisualElement class="fui-status-bar-left">
                            <ui:VisualElement class="fui-crosshair-box">
                                <ui:Label text="›" class="fui-crosshair-icon" />
                            </ui:VisualElement>
                            <ui:Label name="header-open-state" text="open" class="fui-open-text" />
                            <ui:Label text="-&gt;" class="fui-arrow-cyan" />
                            <ui:Label name="header-base-title" text="Basic Window Lifecycle" class="fui-base-title" />
                            <ui:VisualElement name="header-overlay-badge" class="fui-overlay-badge is-hidden" style="display: none;">
                                <ui:VisualElement class="fui-overlay-dot" />
                                <ui:Label text="+ OVERLAY: Modals/Popups" class="fui-overlay-badge-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="header-layer-tag" text="LAYER_Z // 1_BASE_100" class="fui-telemetry-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="fui-viewport-frame">
                        
                        <ui:VisualElement class="fui-viewport-header">
                            <ui:VisualElement class="fui-viewport-meta">
                                <ui:VisualElement class="fui-viewport-badge-row">
                                    <ui:Label name="viewport-id-badge" text="VIEWPORT_01" class="fui-vp-badge" />
                                    <ui:Label name="viewport-sub-badge" text="// LIFECYCLE_STATE_MACHINE" class="fui-vp-sub" />
                                </ui:VisualElement>
                                <ui:Label name="viewport-coords" text="BASE_STATE: ACTIVE" class="fui-vp-coords" />
                            </ui:VisualElement>

                            <ui:VisualElement class="fui-close-btn-wrapper">
                                <ui:Button name="btn-main-close" class="fui-close-btn">
                                    <ui:Label text="X" class="fui-close-btn-text" />
                                </ui:Button>
                                <ui:Label name="close-btn-hint" text="CLS // WIN" class="fui-close-btn-hint" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="ViewportContentArea" style="flex-grow: 1;" />

                        <ui:VisualElement class="fui-viewport-footer">
                            <ui:VisualElement class="fui-footer-left">
                                <ui:Label text="× × ×" class="fui-footer-crosses" />
                                <ui:VisualElement class="fui-footer-hazard-bar" />
                                <ui:Label name="footer-status-log" text="STATE_SYNC // READY" class="fui-footer-log" />
                            </ui:VisualElement>
                            <ui:Label text="══════◣ SUIF_VIEWPORT_BUS ◢══════" class="fui-footer-center" />
                            <ui:VisualElement class="fui-footer-right">
                                <ui:Label text="&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;" class="fui-footer-chevrons" />
                                <ui:Label text="+" class="fui-footer-plus-box" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

