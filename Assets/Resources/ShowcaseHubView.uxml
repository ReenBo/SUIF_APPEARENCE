<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="ShowcaseHubView.uss" />

    <ui:VisualElement name="ShowcaseHubRoot" class="fui-root theme-mono" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="MainFrame" class="fui-frame">
            
            <ui:Label text="+ FRM_00" class="fui-hud-notch-tl" />
            <ui:Label text="ABER_MONO // UTF-8 ×" class="fui-hud-notch-tr" />
            <ui:Label text="[SYS_LOC: 0x00F49A]" class="fui-hud-notch-bl" />
            <ui:Label text="+ ////////////////////// +" class="fui-hud-notch-br" />

            <ui:VisualElement class="fui-header">
                <ui:VisualElement class="fui-header-top">
                    <ui:VisualElement class="fui-header-left">
                        <ui:VisualElement class="fui-hazard-box">
                            <ui:VisualElement class="fui-hazard-pattern" />
                        </ui:VisualElement>
                        <ui:VisualElement class="fui-header-titles">
                            <ui:VisualElement class="fui-sub-title-row">
                                <ui:VisualElement class="fui-sub-title-dot" />
                                <ui:Label text="CYBERPUNK_UISET // ARCHITECTURE_PROTOTYPE" class="fui-sub-title-text" />
                                <ui:Label text="[v0.9.4]" class="fui-sub-title-version" />
                            </ui:VisualElement>
                            <ui:VisualElement class="fui-main-title-row">
                                <ui:Label text="WELCOME TO SUIF" class="fui-main-title" />
                                <ui:Label text="KERNEL_READY" class="fui-kernel-badge" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="fui-header-right">
                        <ui:VisualElement class="fui-telemetry-row">
                            <ui:Label text="ACTIVE_BASE:" class="fui-telemetry-label" />
                            <ui:Label name="telemetry-base-readout" text="01_LIFECYCLE" class="fui-telemetry-value" />
                            <ui:Label text="■" class="fui-telemetry-pip" />
                        </ui:VisualElement>
                        <ui:VisualElement class="fui-telemetry-row">
                            <ui:Label text="OVERLAY_STACK:" class="fui-telemetry-label" />
                            <ui:Label name="telemetry-modal-readout" text="MOUNTED [1]" class="fui-telemetry-badge" />
                        </ui:VisualElement>
                        <ui:VisualElement class="fui-segmented-bar">
                            <ui:VisualElement class="fui-segment-block" />
                            <ui:VisualElement class="fui-segment-block" />
                            <ui:VisualElement class="fui-segment-block" />
                            <ui:VisualElement class="fui-segment-block" />
                            <ui:VisualElement class="fui-segment-block-dim" />
                            <ui:VisualElement class="fui-segment-fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="fui-divider-row">
                    <ui:VisualElement class="fui-divider-line" />
                    <ui:VisualElement class="fui-divider-notch" />
                    <ui:Label text="┼ SECT_SPLIT ┼" class="fui-divider-tag" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="fui-workspace">
                
                <ui:VisualElement class="fui-sidebar">
                    <ui:VisualElement>
                        <ui:VisualElement class="fui-sidebar-section-header">
                            <ui:VisualElement class="fui-sidebar-section-top">
                                <ui:VisualElement class="fui-sidebar-title-row">
                                    <ui:Label text="»" class="fui-sidebar-chevron" />
                                    <ui:Label text="available views" class="fui-sidebar-title" />
                                </ui:VisualElement>
                                <ui:Label text="05 // NODES" class="fui-sidebar-count-badge" />
                            </ui:VisualElement>
                            <ui:VisualElement class="fui-sidebar-underline">
                                <ui:VisualElement class="fui-underline-white" />
                                <ui:VisualElement class="fui-underline-red" />
                                <ui:VisualElement class="fui-underline-fade" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="fui-nav-stack">
                            <ui:Button name="nav-btn-lifecycle" class="fui-nav-btn is-active">
                                <ui:VisualElement class="fui-nav-btn-left">
                                    <ui:Label text="01" class="fui-btn-tag" />
                                    <ui:Label text="Basic Window Lifecycle" class="fui-btn-label" />
                                </ui:VisualElement>
                                <ui:Label text="+" class="fui-btn-arrow" />
                            </ui:Button>

                            <ui:Button name="nav-btn-mvvm" class="fui-nav-btn">
                                <ui:VisualElement class="fui-nav-btn-left">
                                    <ui:Label text="02" class="fui-btn-tag" />
                                    <ui:Label text="MVVM &amp; R3 Reactive Counter" class="fui-btn-label" />
                                </ui:VisualElement>
                                <ui:Label text="›" class="fui-btn-arrow" />
                            </ui:Button>

                            <ui:Button name="nav-btn-list" class="fui-nav-btn">
                                <ui:VisualElement class="fui-nav-btn-left">
                                    <ui:Label text="03" class="fui-btn-tag" />
                                    <ui:Label text="Virtualized Recycled List" class="fui-btn-label" />
                                </ui:VisualElement>
                                <ui:Label text="|||" class="fui-btn-arrow" />
                            </ui:Button>

                            <ui:Button name="nav-btn-modals" class="fui-nav-btn is-active-modal">
                                <ui:VisualElement class="fui-nav-btn-left">
                                    <ui:Label text="04" class="fui-btn-tag" />
                                    <ui:Label text="Modals/Popups" class="fui-btn-label" />
                                </ui:VisualElement>
                                <ui:Label text="&gt;&gt;&gt;" class="fui-btn-arrow" />
                            </ui:Button>

                            <ui:Button name="nav-btn-inventory" class="fui-nav-btn">
                                <ui:VisualElement class="fui-nav-btn-left">
                                    <ui:Label text="05" class="fui-btn-tag" />
                                    <ui:Label text="INVENTORY" class="fui-btn-label" />
                                </ui:VisualElement>
                                <ui:Label text="×" class="fui-btn-arrow" />
                            </ui:Button>
                        </ui:VisualElement>

                        <ui:VisualElement class="fui-sidebar-note">
                            <ui:VisualElement>
                                <ui:Label text="MODAL_EXCEPTION_RULE" class="fui-note-title" />
                                <ui:Label text="[04] STACKS OVER ACTIVE VIEW" class="fui-note-sub" />
                            </ui:VisualElement>
                            <ui:Label text="[BUS]" class="fui-note-title" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="fui-sidebar-bottom">
                        <ui:Button name="nav-btn-theme" class="fui-nav-btn">
                            <ui:VisualElement class="fui-nav-btn-left">
                                <ui:Label text="06" class="fui-btn-tag" />
                                <ui:Label text="Dynamic Theme Switcher" class="fui-btn-label" />
                            </ui:VisualElement>
                            <ui:Label text="■" class="fui-btn-arrow" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="fui-v-divider">
                    <ui:Label text="▲" class="fui-v-arrow" />
                    <ui:VisualElement class="fui-v-line">
                        <ui:VisualElement class="fui-v-tick" />
                        <ui:VisualElement class="fui-v-center-box">
                            <ui:Label text="+" class="fui-v-center-text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="fui-v-tick" />
                    </ui:VisualElement>
                    <ui:Label text="▼" class="fui-v-arrow" />
                </ui:VisualElement>

                <ui:VisualElement class="fui-viewport-container">
                    
                    <ui:VisualElement class="fui-viewport-status-bar">
                        <ui:VisualElement class="fui-status-bar-left">
                            <ui:VisualElement class="fui-crosshair-box">
                                <ui:Label text="›" class="fui-crosshair-icon" />
                            </ui:VisualElement>
                            <ui:Label name="header-open-state" text="open" class="fui-open-text" />
                            <ui:Label text="-&gt;" class="fui-arrow-cyan" />
                            <ui:Label name="header-base-title" text="Basic Window Lifecycle" class="fui-base-title" />
                            <ui:VisualElement name="header-overlay-badge" class="fui-overlay-badge">
                                <ui:VisualElement class="fui-overlay-dot" />
                                <ui:Label text="+ OVERLAY: Modals/Popups" class="fui-overlay-badge-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="header-layer-tag" text="LAYER_Z // 1_BASE + MODAL_999" class="fui-telemetry-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="fui-viewport-frame">
                        
                        <ui:VisualElement class="fui-viewport-header">
                            <ui:VisualElement class="fui-viewport-meta">
                                <ui:VisualElement class="fui-viewport-badge-row">
                                    <ui:Label name="viewport-id-badge" text="VIEWPORT_01" class="fui-vp-badge" />
                                    <ui:Label name="viewport-sub-badge" text="// LIFECYCLE_CONTROLLER" class="fui-vp-sub" />
                                </ui:VisualElement>
                                <ui:Label name="viewport-coords" text="BASE: 1 // OVERLAY: MODALS_04" class="fui-vp-coords" />
                            </ui:VisualElement>

                            <ui:VisualElement class="fui-close-btn-wrapper">
                                <ui:Button name="btn-main-close" class="fui-close-btn">
                                    <ui:Label text="X" class="fui-close-btn-text" />
                                </ui:Button>
                                <ui:Label name="close-btn-hint" text="CLS // OVR" class="fui-close-btn-hint" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="fui-stage-container">
                            
                            <ui:VisualElement name="stage-lifecycle" class="fui-stage">
                                <ui:VisualElement class="fui-stage-header">
                                    <ui:VisualElement>
                                        <ui:Label text="MODULE_01 // STATE_MACHINE" class="fui-stage-tag" />
                                        <ui:Label text="Basic Window Lifecycle Pipeline" class="fui-stage-title" />
                                    </ui:VisualElement>
                                    <ui:Button name="btn-lifecycle-modal-test" text="+ TEST MODAL OVERLAY [04]" class="fui-modal-test-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="fui-lifecycle-grid">
                                    <ui:Button name="btn-stage-init" class="fui-lifecycle-step-btn">
                                        <ui:Label text="STEP_01" class="fui-step-label" />
                                        <ui:Label text="OnInitialize()" class="fui-step-name" />
                                    </ui:Button>
                                    <ui:Button name="btn-stage-open" class="fui-lifecycle-step-btn">
                                        <ui:Label text="STEP_02" class="fui-step-label" />
                                        <ui:Label text="OnOpen()" class="fui-step-name" />
                                    </ui:Button>
                                    <ui:Button name="btn-stage-show" class="fui-lifecycle-step-btn is-active">
                                        <ui:Label text="STEP_03 ●" class="fui-step-label" />
                                        <ui:Label text="OnShow()" class="fui-step-name" />
                                    </ui:Button>
                                    <ui:Button name="btn-stage-hide" class="fui-lifecycle-step-btn">
                                        <ui:Label text="STEP_04" class="fui-step-label" />
                                        <ui:Label text="OnHide()" class="fui-step-name" />
                                    </ui:Button>
                                    <ui:Button name="btn-stage-close" class="fui-lifecycle-step-btn">
                                        <ui:Label text="STEP_05" class="fui-step-label" />
                                        <ui:Label text="OnClose()" class="fui-step-name" />
                                    </ui:Button>
                                </ui:VisualElement>

                                <ui:VisualElement class="fui-console-box">
                                    <ui:VisualElement class="fui-console-header">
                                        <ui:Label text="LIFECYCLE_EVENT_LOG // STREAM" class="fui-console-title" />
                                        <ui:Label text="CURRENT_HOOK: OnShow()" class="fui-console-hook" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="lifecycle-logs-container" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement name="stage-mvvm" class="fui-stage" style="display: none;">
                                <ui:VisualElement class="fui-stage-header">
                                    <ui:VisualElement>
                                        <ui:Label text="MODULE_02 // ZERO_ALLOC_BINDING" class="fui-stage-tag-red" />
                                        <ui:Label text="MVVM &amp; R3 Reactive Counter" class="fui-stage-title" />
                                    </ui:VisualElement>
                                    <ui:Label text="ReactiveProperty&lt;int&gt;" class="fui-btn-tag" />
                                </ui:VisualElement>

                                <ui:VisualElement class="fui-counter-grid">
                                    <ui:VisualElement class="fui-counter-display">
                                        <ui:Label text="LIVE_VALUE // R3_STREAM" class="fui-counter-label" />
                                        <ui:Label name="label-counter-value" text="042" class="fui-counter-val" />
                                        <ui:Label text="GC_ALLOC: 0 BYTES" class="fui-counter-alloc" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="fui-counter-controls">
                                        <ui:VisualElement class="fui-counter-btn-row">
                                            <ui:Button name="btn-counter-dec" text="[ -1 DEC ]" class="fui-counter-btn" />
                                            <ui:Button name="btn-counter-inc" text="[ +1 INC ]" class="fui-counter-btn" />
                                            <ui:Button name="btn-counter-boost" text="[ +10 BOOST ]" class="fui-counter-btn" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="fui-marble-box">
                                            <ui:VisualElement class="fui-marble-header">
                                                <ui:Label text="R3_OBSERVABLE_MARBLE_HISTORY" class="fui-marble-title" />
                                                <ui:Button name="btn-counter-reset" text="RESET_STREAM" class="fui-marble-reset" />
                                            </ui:VisualElement>
                                            <ui:VisualElement name="counter-marbles-container" class="fui-marble-stream" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement name="stage-list" class="fui-stage" style="display: none;">
                                <ui:VisualElement class="fui-stage-header">
                                    <ui:VisualElement>
                                        <ui:Label text="MODULE_03 // VIRTUALIZED_VIEWPORT" class="fui-stage-tag" />
                                        <ui:Label text="Virtualized Recycled List (10,000 Rows // 6 DOM Nodes)" class="fui-stage-title" />
                                    </ui:VisualElement>
                                    <ui:Label text="ACTIVE_POOL: 6" class="fui-vp-badge" />
                                </ui:VisualElement>

                                <ui:ScrollView name="list-nodes-container" class="fui-recycled-scroll" />
                            </ui:VisualElement>

                            <ui:VisualElement name="stage-inventory" class="fui-stage" style="display: none;">
                                <ui:VisualElement class="fui-stage-header">
                                    <ui:VisualElement>
                                        <ui:Label text="MODULE_05 // TACTICAL_CARGO_GRID" class="fui-stage-tag-red" />
                                        <ui:Label text="Cyberware &amp; Hardware Inventory" class="fui-stage-title" />
                                    </ui:VisualElement>
                                    <ui:Label text="CAPACITY: 13.3 / 64.0 KG" class="fui-vp-sub" />
                                </ui:VisualElement>

                                <ui:VisualElement class="fui-inventory-grid-wrap">
                                    <ui:VisualElement name="inventory-slots-container" class="fui-inventory-slots-box" />

                                    <ui:VisualElement class="fui-inventory-inspector">
                                        <ui:VisualElement>
                                            <ui:VisualElement class="fui-header-top">
                                                <ui:Label text="ITEM_INSPECTOR" class="fui-stage-tag" />
                                                <ui:Label name="inventory-inspector-rarity" text="[ICONIC]" class="fui-step-label" />
                                            </ui:VisualElement>
                                            <ui:Label name="inventory-inspector-name" text="MANTIS_BLADE_MK4" class="fui-inspector-name" />
                                            <ui:Label name="inventory-inspector-power" text="940 DPS" class="fui-inspector-power" />
                                            <ui:Label name="inventory-inspector-desc" text="High-frequency thermal monowire edge with neural reflex link." class="fui-inspector-desc" />
                                        </ui:VisualElement>
                                        <ui:Button name="btn-inventory-modal-inspect" text="INSPECT IN MODAL [04]" class="fui-counter-btn" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement name="stage-theme" class="fui-stage" style="display: none;">
                                <ui:VisualElement class="fui-stage-header">
                                    <ui:VisualElement>
                                        <ui:Label text="MODULE_06 // GLOBAL_PALETTE_ENGINE" class="fui-stage-tag" />
                                        <ui:Label text="Dynamic Theme Switcher Matrix" class="fui-stage-title" />
                                    </ui:VisualElement>
                                    <ui:Label text="ACTIVE: MONO" class="fui-vp-badge" />
                                </ui:VisualElement>

                                <ui:VisualElement class="fui-theme-grid">
                                    <ui:Button name="btn-theme-mono" class="fui-theme-card">
                                        <ui:VisualElement class="fui-theme-card-header">
                                            <ui:Label text="ABER_MONO // HIGH_CONTRAST" class="fui-theme-card-name" />
                                            <ui:VisualElement class="fui-theme-card-accent" style="background-color: #f4f4f6;" />
                                        </ui:VisualElement>
                                        <ui:Label text="Default pure white vector FUI with cyan/crimson chromatic accents." class="fui-theme-card-desc" />
                                    </ui:Button>

                                    <ui:Button name="btn-theme-cyan" class="fui-theme-card">
                                        <ui:VisualElement class="fui-theme-card-header">
                                            <ui:Label text="NETRUNNER // CYBER_CYAN" class="fui-theme-card-name" />
                                            <ui:VisualElement class="fui-theme-card-accent" style="background-color: #00f0ff;" />
                                        </ui:VisualElement>
                                        <ui:Label text="Ice-blue ocular HUD projection optimized for subnet telemetry." class="fui-theme-card-desc" />
                                    </ui:Button>

                                    <ui:Button name="btn-theme-crimson" class="fui-theme-card">
                                        <ui:VisualElement class="fui-theme-card-header">
                                            <ui:Label text="ARASAKA // TACTICAL_RED" class="fui-theme-card-name" />
                                            <ui:VisualElement class="fui-theme-card-accent" style="background-color: #ff2a54;" />
                                        </ui:VisualElement>
                                        <ui:Label text="High-alert crimson combat visor palette with inverted laser edge." class="fui-theme-card-desc" />
                                    </ui:Button>

                                    <ui:Button name="btn-theme-amber" class="fui-theme-card">
                                        <ui:VisualElement class="fui-theme-card-header">
                                            <ui:Label text="RETRO_CRT // PHOSPHOR_AMBER" class="fui-theme-card-name" />
                                            <ui:VisualElement class="fui-theme-card-accent" style="background-color: #ffb800;" />
                                        </ui:VisualElement>
                                        <ui:Label text="Industrial orbital terminal amber monochrome spectrum." class="fui-theme-card-desc" />
                                    </ui:Button>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement name="stage-idle" class="fui-stage" style="display: none;">
                                <ui:VisualElement class="fui-idle-box">
                                    <ui:Label text="×" class="fui-idle-cross" />
                                    <ui:Label text="ALL BASE WINDOWS CLOSED // STANDBY" class="fui-idle-title" />
                                    <ui:Label text="CLICK ANY VIEW BUTTON [01–06] IN THE LEFT PANEL TO MOUNT A WINDOW MODULE" class="fui-idle-sub" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement name="modal-overlay-layer" class="fui-modal-overlay">
                                <ui:VisualElement class="fui-modal-dialog">
                                    <ui:VisualElement class="fui-modal-banner">
                                        <ui:VisualElement class="fui-modal-banner-left">
                                            <ui:Label text="MODAL_04" class="fui-modal-tag" />
                                            <ui:VisualElement>
                                                <ui:Label text="Modals/Popups // OVERLAY_STACK" class="fui-modal-heading" />
                                                <ui:Label name="modal-underlying-label" text="RENDERED ABOVE BASE: Basic Window Lifecycle" class="fui-modal-underlying" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:Button name="btn-modal-close" text="[ X ]" class="fui-modal-x-btn" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="fui-modal-danger-box">
                                        <ui:VisualElement class="fui-modal-danger-top">
                                            <ui:Label text="!" class="fui-modal-warning-icon" />
                                            <ui:VisualElement class="fui-modal-danger-content">
                                                <ui:VisualElement class="fui-modal-danger-title-row">
                                                    <ui:Label name="modal-alert-title" text="DANGER // POPUP_INTERCEPT" class="fui-modal-danger-title" />
                                                    <ui:Label name="modal-stack-counter" text="DEPTH: 1" class="fui-modal-depth-badge" />
                                                </ui:VisualElement>
                                                <ui:Label name="modal-body-message" text="This modal layer is non-destructively mounted over the active base window. Underlying reactive streams and lifecycle states remain preserved in memory." class="fui-modal-body-msg" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="fui-modal-danger-stripe" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="fui-modal-action-row">
                                        <ui:Button name="btn-modal-push" text="+ PUSH SUB-POPUP" class="fui-modal-btn" />
                                        <ui:Button name="btn-modal-cycle" text="↻ SWITCH PAYLOAD" class="fui-modal-btn" />
                                        <ui:Button name="btn-modal-dismiss" text="DISMISS OVERLAY" class="fui-modal-btn is-dismiss" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="fui-modal-footer">
                                        <ui:Label text="BACKDROP_BLUR: ACTIVE" class="fui-modal-footer-tag" />
                                        <ui:Label text="Z_INDEX: 999 // MODAL_QUEUE" class="fui-modal-footer-tag" />
                                        <ui:Label text="&gt;&gt;&gt;&gt;&gt;" class="fui-modal-footer-tag" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                        </ui:VisualElement>

                        <ui:VisualElement class="fui-viewport-footer">
                            <ui:VisualElement class="fui-footer-left">
                                <ui:Label text="× × ×" class="fui-footer-crosses" />
                                <ui:VisualElement class="fui-footer-hazard-bar" />
                                <ui:Label name="footer-status-log" text="STATE_SYNC // READY" class="fui-footer-log" />
                            </ui:VisualElement>
                            <ui:Label text="══════◣ SUIF_VIEWPORT_BUS ◢══════" class="fui-footer-center" />
                            <ui:VisualElement class="fui-footer-right">
                                <ui:Label text="&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;" class="fui-footer-chevrons" />
                                <ui:Label text="+" class="fui-footer-plus-box" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
